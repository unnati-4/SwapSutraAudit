{
  "rewrites": [
    {
      "source": "/api/swapsutra",
      "destination": "/api/swapsutra.ts"
    },
    {
      "source": "/api/quill/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/notifications/:route",
      "destination": "/api/notifications.ts?route=:route"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/book/:id",
      "destination": "/api/book-page?id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
